# Environment Configuration
NODE_ENV=production

# Server
PORT=3000

# Redis
REDIS_URL=redis://redis:6379
REDIS_TTL=3600

# Scraper Settings
SCRAPER_TIMEOUT=30000
MAX_RESULTS=50

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend (pour le build)
VITE_API_URL=http://localhost:3000
